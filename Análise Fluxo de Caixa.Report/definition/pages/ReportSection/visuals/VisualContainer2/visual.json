{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.7.0/schema.json",
  "name": "VisualContainer2",
  "position": {
    "x": 0,
    "y": 0,
    "z": 0,
    "height": 80,
    "width": 1280
  },
  "visual": {
    "visualType": "basicShape",
    "objects": {
      "general": [
        {
          "properties": {
            "shapeType": {
              "expr": {
                "Literal": {
                  "Value": "'rectangle'"
                }
              }
            }
          }
        }
      ],
      "line": [
        {
          "properties": {
            "lineColor": {
              "solid": {
                "color": {
                  "expr": {
                    "ThemeDataColor": {
                      "ColorId": 1,
                      "Percent": 0
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "fill": [
        {
          "properties": {
            "fillColor": {
              "solid": {
                "color": {
                  "expr": {
                    "ThemeDataColor": {
                      "ColorId": 1,
                      "Percent": 0
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}