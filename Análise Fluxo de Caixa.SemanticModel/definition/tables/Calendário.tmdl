/// Tabela dimensão de calendário contínua para filtros temporais, agregações cronológicas e cálculos de Time Intelligence.
table Calendário
	lineageTag: 0580df27-5c58-41df-a7e0-31a0966b353e

	/// Data diária única contínua. Chave de relacionamento primária com as datas das tabelas fato.
	column Data
