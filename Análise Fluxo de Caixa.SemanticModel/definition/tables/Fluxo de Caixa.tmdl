/// Tabela fato contendo os registros históricos de movimentações financeiras (entradas e saídas de caixa), base para análises de liquidez e fluxo de caixa.
table 'Fluxo de Caixa'
	lineageTag: f738205b-6777-4e5a-af36-b01509fa8dfb

	/// Data em que ocorreu a movimentação financeira. Chave de relacionamento com a tabela Calendário.
	column Data
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: 6b760dc9-7c15-42b4-a52f-765792054e17
		summarizeBy: none
		sourceColumn: Data

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	/// Classificação da movimentação financeira (ex.: Entrada ou Saída).
	column Tipo
		dataType: string
		lineageTag: 6191bfed-b132-47ab-bd63-8d41daa9ae41
		summarizeBy: none
		sourceColumn: Tipo

		annotation SummarizationSetBy = Automatic

	/// Categoria ou classificação financeira do lançamento (ex.: Custos Fixos, Receitas de Vendas, Despesas Operacionais).
	column Categoria
		dataType: string
		lineageTag: a4dfba06-3fcd-4d1a-92a8-6e9f7ccf8eae
		summarizeBy: none
		sourceColumn: Categoria

		annotation SummarizationSetBy = Automatic

	/// Valor financeiro monetário transacionado no lançamento.
	column Movimentação
		dataType: double
		lineageTag: a2dda666-b2a4-44f7-97ad-dd15a5520542
		summarizeBy: sum
		sourceColumn: Movimentação

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Saldo financeiro resultante ou registrado após a movimentação.
	column Saldo
		dataType: double
		lineageTag: 7843d29f-a421-4b56-bdbc-b842a6c04dfb
		summarizeBy: sum
		sourceColumn: Saldo

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition 'Fluxo de Caixa-04cfc726-dc0e-4098-8d30-b8e8be60c21f' = m
		mode: import
		source =
				let
				    Origem = Excel.Workbook(File.Contents("C:\Users\karin\Dropbox\Fluxo de Caixa\Fluxo de Caixa no Excel.xlsx"), null, true),
				    Tabela1_Table = Origem{[Item="Tabela1",Kind="Table"]}[Data],
				    #"Tipo Alterado" = Table.TransformColumnTypes(Tabela1_Table,{{"Data", type date}, {"Tipo", type text}, {"Categoria", type text}, {"Movimentação", type number}, {"Saldo", type number}})
				in
				    #"Tipo Alterado"

	annotation PBI_ResultType = Exception

